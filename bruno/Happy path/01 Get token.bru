meta {
  name: Get token
  type: http
  seq: 1
}

post {
  url: {{issuer}}/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{user}}
  client_secret: any
  scope: {{audience}}
}

assert {
  res.status: eq 200
  res.body.access_token: isString
}

script:post-response {
  bru.setVar("token", res.body.access_token);
}
