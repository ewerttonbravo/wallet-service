meta {
  name: Shortened transaction id
  type: http
  seq: 23
}

get {
  url: {{api}}/wallets/me/transactions/1-1-1-1-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 400
  res.body.detail: eq "id must be a transaction id such as \"6f1c2e9a-0d5b-4c4e-9a43-5d8f0b1e2c3d\""
}

tests {
  test("does not echo the rejected id in the detail", function () {
    expect(res.getBody().detail).to.not.contain("1-1-1-1-1");
  });
}

docs {
  Java reads 1-1-1-1-1 as a UUID; only the full form names a transaction, as the contract says.
}
