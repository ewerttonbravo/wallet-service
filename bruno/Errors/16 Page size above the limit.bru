meta {
  name: Page size above the limit
  type: http
  seq: 16
}

get {
  url: {{api}}/wallets/me/transactions?size=101
  body: none
  auth: bearer
}

params:query {
  size: 101
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 400
  res.body.detail: eq "size must be a whole number from 1 to 100"
}

docs {
  A page holds at most 100 transactions. The detail states the rule without echoing the value.
}
